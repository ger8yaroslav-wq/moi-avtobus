<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мой автобус"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Добавляйте маршруты без ограничения и объединяйте автобусы с общим направлением."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel_background"
            android:padding="14dp"
            android:text="Обновляю прогнозы…"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <Button
            android:id="@+id/refresh_now"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="10dp"
            android:text="ОБНОВИТЬ СЕЙЧАС" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="Настройка виджета"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/route_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
        <LinearLayout
            android:id="@+id/configured_routes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
        <Button
            android:id="@+id/add_route"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginTop="12dp"
            android:text="ДОБАВИТЬ АВТОБУС" />
        <Button
            android:id="@+id/merge_routes"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginTop="8dp"
            android:text="ВЫБРАТЬ И ОБЪЕДИНИТЬ" />
        <Button
            android:id="@+id/unmerge_routes"
            android:layout_width="match_parent"
            android:layout_height="43dp"
            android:layout_marginTop="6dp"
            android:text="РАЗЪЕДИНИТЬ АВТОБУСЫ"
            android:visibility="gone" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:text="Диагностика"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/diagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel_background"
            android:fontFamily="monospace"
            android:padding="13dp"
            android:text="Отчёт появится после обновления."
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true"
            android:textSize="11sp" />
        <Button
            android:id="@+id/copy_report"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:text="СКОПИРОВАТЬ ОТЧЁТ" />
        <Button
            android:id="@+id/open_transport"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="22dp"
            android:text="МОСКОВСКИЙ ТРАНСПОРТ" />
    </LinearLayout>
</ScrollView>
